{
  "ApiAccess": {
    "RequireApiKey": true,
    "BootstrapAdminKey": ""
  },
  "Fiscalization": {
    "CertificateVault": {
      "RootPath": "App_Data/Certificates",
      "MasterKeyBase64": ""
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
